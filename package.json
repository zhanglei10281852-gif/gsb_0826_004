{
  "name": "nexa-ui",
  "version": "0.1.0",
  "description": "Modern Vue 3 component library with atomic design principles",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "ui",
    "typescript",
    "unocss"
  ],
  "main": "./dist/es/index.mjs",
  "module": "./dist/es/index.mjs",
  "types": "./dist/es/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/es/index.d.ts",
      "import": "./dist/es/index.mjs"
    },
    "./components/*": {
      "types": "./dist/es/components/*/index.d.ts",
      "import": "./dist/es/components/*/index.mjs"
    },
    "./style.css": "./dist/es/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "gen": "node scripts/generate-entry.mjs",
    "predev": "node scripts/generate-entry.mjs",
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "prebuild": "node scripts/generate-entry.mjs",
    "build": "vite build --mode lib && vue-tsc -p tsconfig.build.json",
    "build:demo": "vite build",
    "verify": "node scripts/verify.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@vueuse/motion": "^2.2.6"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.25",
    "@iconify-json/mdi": "^1.2.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "~5.9.2",
    "unocss": "^66.8.1",
    "vite": "^7.3.6",
    "vue": "^3.4.0",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=18"
  }
}
