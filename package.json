{
  "name": "nexa-ui",
  "version": "0.1.0",
  "description": "Modern Vue 3 component library with atomic design principles",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "ui",
    "typescript",
    "unocss"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.mjs",
      "require": "./dist/*/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/gen-index.mjs",
    "gen-index": "node scripts/gen-index.mjs",
    "prebuild": "node scripts/gen-index.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "verify": "node scripts/verify.mjs"
  },
  "peerDependencies": {
    "@vueuse/motion": "^2.2.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.0",
    "@iconify-json/mdi": "^1.2.0",
    "@types/node": "^26.3.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/tsconfig": "^0.5.1",
    "@vueuse/motion": "^2.2.0",
    "typescript": "^5.5.0",
    "unocss": "^0.62.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.1.0"
  }
}
